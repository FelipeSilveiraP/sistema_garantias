<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.chaveiro</groupId>
    <artifactId>garantias-backend</artifactId>
    <version>0.1.0</version>
    <name>Sistema de Garantias - Chaveiro Universal (Backend)</name>
    <description>API REST local do Sistema de Garantias - Chaveiro Universal</description>

    <properties>
        <java.version>21</java.version>
        <sqlite.version>3.54.1.0</sqlite.version>
        <!-- correcoes de seguranca acima das versoes do Spring Boot 3.5.16 (OSV-Scanner, 2026-11-15) -->
        <tomcat.version>10.1.59</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- envio do codigo de redefinicao do PIN pelo Gmail da loja (SMTP) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- analise estatica de seguranca: mvn -f backend/pom.xml -P seguranca compile spotbugs:check
             (SpotBugs + Find Security Bugs; falsos positivos revisados ficam em spotbugs-excluir.xml) -->
        <profile>
            <id>seguranca</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.9.8.5</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <onlyAnalyze>com.chaveiro.-</onlyAnalyze>
                            <excludeFilterFile>${project.basedir}/spotbugs-excluir.xml</excludeFilterFile>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>1.14.0</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
